# Local names only. Copy to .env.local and set real values there.
# .env.local is gitignored. Do not put real secrets in this file.

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://mb:change-me@127.0.0.1:5432/mbevents
DATABASE_URL_UNPOOLED=postgres://mb:change-me@127.0.0.1:5432/mbevents

# Office sign-in. Required for production.
# MB_ADMIN_EMAIL=
# MB_ADMIN_PASSWORD=

# MFA at-rest encryption (min 16 chars). Required before enabling MFA.
# MB_MFA_ENCRYPTION_KEY=

# Public site origin used in invite/planner links (no trailing slash).
# MB_PUBLIC_ORIGIN=http://localhost:5173

# File storage: local (default) or s3. Use s3 before multi-instance / serverless production.
# MB_FILE_STORAGE=local
# MB_FILE_DIR=
# MB_S3_BUCKET=
# MB_S3_REGION=
# MB_S3_ENDPOINT=
# MB_S3_ACCESS_KEY_ID=
# MB_S3_SECRET_ACCESS_KEY=

# Backups
# MB_BACKUP_DIR=./backups

# Email (Resend). Leave unset to fail closed. Prefer sandbox first.
# RESEND_API_KEY=
# MB_FROM_EMAIL=
# MB_NOTIFY_EMAIL=
# MB_EMAIL_SANDBOX=true

# SMS — requires MB_SMS_ENABLED=true AND provider fields. Off by default.
# MB_SMS_ENABLED=false
# MB_SMS_ACCOUNT_SID=
# MB_SMS_AUTH_TOKEN=
# MB_SMS_FROM=

# Stripe — test keys only until live payments are explicitly approved.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Job worker interval when using `pnpm run jobs:worker`
# MB_JOB_INTERVAL_MS=60000
