{
  "name": "@workspace/mb-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/require-postgres.mjs && node scripts/migrate.mjs && next dev -p 8081",
    "db:up": "docker compose --env-file .env.local up -d --wait",
    "db:local": "node scripts/pg-local.mjs",
    "build": "node scripts/migrate.mjs && next build",
    "start": "node scripts/require-postgres.mjs && node scripts/migrate.mjs && next start -p 8081",
    "start:8082": "node scripts/require-postgres.mjs && node scripts/migrate.mjs && next start -p 8082",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "jobs:once": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/job-worker.ts --once",
    "jobs:worker": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/job-worker.ts",
    "check:integrations": "node scripts/integration-check.mjs",
    "smoke:prod": "node scripts/run-smoke-prod.mjs",
    "test:foundation": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/foundation-test.ts",
    "test:crm": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/crm-test.ts",
    "test:portal": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/portal-test.ts",
    "test:calendar": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/calendar-test.ts",
    "test:analytics": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/analytics-test.ts",
    "test:finance": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/finance-test.ts",
    "test:automations": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/automations-test.ts",
    "test:operations": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/operations-test.ts",
    "test:invites": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/invites-test.ts",
    "test:settings": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/settings-test.ts",
    "test:availability": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/availability-test.ts",
    "test:sales": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/sales-workflow-test.ts",
    "test:integrity": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/finance-integrity-test.ts",
    "test:communications": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/communications-test.ts",
    "test:office": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/office-desk-test.ts",
    "test:customers": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/customers-test.ts",
    "test:places": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/places-test.ts",
    "test:tasks": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/workspace-tasks-test.ts",
    "test:timeline": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/timeline-test.ts",
    "test:guest-access": "node --test --experimental-strip-types --import ./scripts/register-alias.mjs scripts/guest-access.test.mjs",
    "test:phase08": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/phase08-journey-test.ts",
    "test:phase09": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/phase09-growth-test.ts",
    "test:crew": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/crew-test.ts",
    "test:budget": "node --experimental-strip-types --import ./scripts/register-alias.mjs scripts/budget-test.ts",
    "test:phase10": "npm run test:crew && npm run test:operations && npm run test:calendar && npm run test:availability",
    "test:phase11": "npm run test:budget && npm run test:finance && npm run test:sales && npm run test:integrity && npm run test:analytics"
  },
  "dependencies": {
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
