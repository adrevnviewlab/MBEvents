{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": false,
    "incremental": false,
    "outDir": "dist-tsc",
    "rootDir": "src",
    "types": ["node"],
    "disableReferencedProjectLoad": true,
    "disableSourceOfProjectReferenceRedirect": true,
    "disableSolutionSearching": true
  },
  "include": ["src"]
